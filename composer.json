{
  "name": "nanasess/mdb2",
  "description": "Maintained fork of PEAR MDB2, a database abstraction layer for PHP",
  "type": "library",
  "keywords": [ "database", "dbal", "database abstraction", "pear", "mdb2", "postgresql", "mysql", "sqlite" ],
  "homepage": "https://github.com/nanasess/MDB2",
  "support": {
    "issues": "https://github.com/nanasess/MDB2/issues",
    "source": "https://github.com/nanasess/MDB2",
    "security": "https://github.com/nanasess/MDB2/security/policy"
  },
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Kentaro Ohkouchi",
      "email": "nanasess@fsm.ne.jp",
      "role": "Maintainer"
    },
    {
      "name": "Lukas Smith",
      "role": "Original author"
    },
    {
      "name": "Lorenzo Alberton",
      "role": "Original author"
    }
  ],
  "require": {
    "php": ">=5.3.0",
    "ext-mbstring": "*",
    "pear/pear-core-minimal": "^1.9.0"
  },
  "autoload": {
      "psr-0": {
          "MDB2": ""
      }
  },
  "include-path": [
      "./"
  ],
  "require-dev": {
      "phpunit/phpunit": "^9.6"
  },
  "scripts": {
      "test": "phpunit"
  }
}
